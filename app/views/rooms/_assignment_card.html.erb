<div class="w-36 h-48 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
  <div class="flex h-full flex-col">
    <!-- Header -->
    <div class="flex items-center gap-2">
      <span class="text-xl font-bold <%= diamond_color_class(assignment.player.color) %>">
        ◆K
      </span>
      <span class="truncate text-sm font-semibold text-slate-700">
        <%= assignment.player.nickname %>
      </span>
    </div>
    <!-- Clue -->
    <div class="flex flex-1 items-center justify-center px-1">
      <p class="text-center text-lg font-semibold leading-tight text-slate-900 wrap-break-word">
        <%= assignment.clue_text %>
      </p>
    </div>
    <!-- Footer (empty for now) -->
    <div class="h-6">
      <!-- Future: revealed number, badges, etc. -->
    </div>
  </div>
</div>
