<% @room = room %>
<% @current_round = @room.rounds.order(created_at: :desc).first %>
<%# <div class="mx-auto max-w-7xl"> %>
<div class="max-w-7xl lg:grid lg:grid-cols-4 lg:gap-4">
  <!-- Left Sidebar -->
  <aside class="lg:col-span-1 bg-blue-300 p-6 shadow-lg rounded-2xl">
    <!-- Room Info -->
    <h2 class="mb-2 text-lg font-semibold text-slate-800">Room Info</h2>
    <div class="mb-6 rounded-xl bg-slate-100 p-4">
      <!-- Room header -->
      <div class="mb-6 flex flex-col items-center justify-between text-center">
        <div>
          <h1 class="text-2xl font-bold text-slate-800">Room <%= room.code %></h1>
          <!-- <p class="text-sm text-slate-600">
            Status: <%= room.status.humanize %>
          </p>
          -->
        </div>
        <% if room.host_player_id == current_player&.id %>
          <span class="rounded-full bg-slate-800 px-3 py-1 text-sm font-semibold text-white">Host</span>
        <% end %>
      </div>
      <p class="text-slate-700 font-medium text-center"><%= room.cards_per_player %> <%= room.cards_per_player > 1 ? 'cards' : 'card' %> per player</p>
    </div>
    <!-- Players -->
    <h2 class="mb-3 text-lg font-semibold text-slate-800">Players</h2>
    <div class="mb-6 rounded-xl bg-slate-200 p-4">
      <div class="space-y-3">
        <% room.players.active.order(:created_at).each do |player| %>
          <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3">
            <div class="flex items-center gap-3">
              <div class="flex shrink-0 gap-1">
                <% if @current_round %>
                  <% @current_round.round_assignments.where(player: player).each do |assignment| %>
                    <span class="text-lg font-bold <%= diamond_color_class(assignment.color) %>">
                      ◆
                    </span>
                  <% end %>
                <% end %>
              </div>
              <span class="font-medium text-slate-800"><%= player.nickname %></span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <% if current_player&.id == player.id %>
                <span class="rounded-full bg-green-300 px-2 py-1 text-xs font-semibold text-green-800">You</span>
              <% end %>
              <% if room.host_player_id == player.id %>
                <span class="rounded-full bg-pink-200 px-2 py-1 text-xs font-semibold text-purple-700">Host</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Buttons and Modals -->
    <div data-controller="confirm-modal">
      <!-- Leave button -->
      <% if current_player %>
        <button
    type="button"
    data-action="confirm-modal#open"
    data-url="<%= player_path(current_player) %>"
    data-method="delete"
    data-message="Leave this room? Your unsubmitted cards will be removed from the current round."
    class="rounded-xl bg-slate-200 px-4 py-2 mb-2 font-semibold text-slate-800 hover:bg-slate-300"
  >
          Leave Room
        </button>
      <% end %>
      <% if current_player&.id == room.host_player_id && room.in_round? %>
        <div class="flex justify-between gap-3">
          <button
    type="button"
    data-action="confirm-modal#open"
    data-url="<%= restart_round_room_path(room.code) %>"
    data-message="Restart this round? Current clues and progress will be discarded, but the same theme will be kept."
    class="rounded-xl bg-slate-200 px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-300"
  >
            Restart Round
          </button>
          <button
    type="button"
    data-action="confirm-modal#open"
    data-url="<%= next_round_room_path(room.code) %>"
    data-message="Start the next round? Current progress will be discarded and a new theme will be chosen."
    class="rounded-xl bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
  >
            Next Round
          </button>
        </div>
      <% end %>
      <%= render "shared/confirm_modal" %>
    </div>
  </aside>
  <!-- Center-Right Gameplay Area -->
  <main class="lg:col-span-3 bg-indigo-300 p-6 shadow-lg rounded-2xl">
    <% if room.lobby? %>
      <!-- Start Round / waiting -->
      <div class="rounded-xl bg-slate-100 p-4">
        <% if room.host_player_id == current_player&.id %>
          <p class="mb-4 text-slate-700">When everyone has joined, start the round.</p>
          <%= button_to "Start Round",
                  start_round_room_path(room.code),
                  method: :post,
                  class: "rounded-xl bg-slate-800 px-4 py-2 font-semibold text-white hover:bg-slate-700" %>
        <% else %>
          <p class="text-slate-700">Waiting for the host to start the round...</p>
        <% end %>
      </div>
    <% else %>
      <!-- Entire gameplay area -->
      <div class="space-y-4">
        <% if @current_round %>
          <div class="flex items-center justify-center gap-3 text-3xl">
            <span class="font-medium text-slate-800">
              Theme →
            </span>
            <div class="rounded-xl bg-slate-100 px-4 py-3">
              <span class="font-semibold text-slate-900">
                <%= @current_round.theme %>
              </span>
            </div>
          </div>
          <% if @current_round.turn? %>
            <div class="rounded-xl bg-slate-100 p-4">
              <h2 class="mb-3 text-lg font-semibold text-slate-800">Submitted Clues</h2>
              <% if @current_round.submitted_assignments.any? %>
                <div class="flex flex-wrap gap-4">
                  <% @current_round.submitted_assignments.each do |assignment| %>
                    <%= render "shared/assignment_card", assignment: assignment %>
                  <% end %>
                </div>
                <!-- 1 to 100 and the Arrow -->
                <%= render "shared/arrows" %>
              <% else %>
                <p class="text-slate-600">No clues submitted yet.</p>
                <%= render "shared/arrows" %>
              <% end %>
            </div>
          <% end %>
          <%# end of submitted clues section %>
          <% if @current_round.arranging? %>
            <div class="rounded-xl bg-slate-100 p-4">
              <h2 class="mb-2 text-lg font-semibold text-slate-800">Arranging</h2>
              <% if current_player&.id == room.host_player_id %>
                <p class="mb-4 text-slate-700">Drag the submitted cards into ascending order (1 to 100, left-to-right), then press Done.</p>
                <div
          class="flex flex-wrap gap-4"
          data-controller="sortable-list"
          data-sortable-list-url-value="<%= update_order_round_path(@current_round) %>"
        >
                  <% @current_round.submitted_assignments.each do |assignment| %>
                    <div
              data-assignment-id="<%= assignment.id %>"
              class="cursor-grab select-none w-36 h-48 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:shadow-md active:cursor-grabbing"
            >
                      <div class="flex h-full flex-col">
                        <!-- Header -->
                        <div class="flex items-center gap-2">
                          <%= render "shared/diamond", assignment: assignment %>
                          <span class="truncate text-sm font-semibold text-slate-700">
                            <%= assignment.player.nickname %>
                          </span>
                        </div>
                        <!-- Clue -->
                        <div class="flex flex-1 items-center justify-center px-1">
                          <p class="text-center text-lg font-semibold leading-tight text-slate-900 wrap-break-word">
                            <%= assignment.clue_text %>
                          </p>
                        </div>
                        <!-- Footer (empty for now) -->
                        <div class="h-6">
                          <!-- Future: revealed number, badges, etc. -->
                          <div class="mt-auto pt-2 text-end">
                            <span class="text-xl font-bold text-slate-900">
                              <%= current_player&.id == assignment.player_id ? assignment.secret_number : "?" %>
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
                <div class="mt-4 flex items-center gap-3">
                  <!-- 1 -->
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-600 text-sm font-semibold text-white">
                    1
                  </div>
                  <!-- Arrow pointing LEFT -->
                  <div class="flex flex-1 items-center">
                    <div class="h-0 w-0 border-y-[5px] border-r-8 border-y-transparent border-r-slate-500"></div>
                    <div class="h-px flex-1 bg-slate-500"></div>
                  </div>
                  <!-- Done -->
                  <%= button_to "Done",
        done_arranging_round_path(@current_round),
        method: :post,
        class: "shrink-0 rounded-xl bg-slate-800 px-4 py-2 font-semibold text-white hover:bg-slate-700" %>
                  <!-- Arrow pointing RIGHT -->
                  <div class="flex flex-1 items-center">
                    <div class="h-px flex-1 bg-slate-500"></div>
                    <div class="h-0 w-0 border-y-[5px] border-l-8 border-y-transparent border-l-slate-500"></div>
                  </div>
                  <!-- 100 -->
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-600 text-sm font-semibold text-white">
                    100
                  </div>
                </div>
              <% else %>
                <p class="mb-4 text-slate-600">Host is arranging the cards...</p>
                <div class="flex flex-wrap gap-4">
                  <% @current_round.submitted_assignments.each do |assignment| %>
                    <%= render "shared/assignment_card", assignment: assignment %>
                  <% end %>
                </div>
                <!-- 1 to 100 and the Arrow -->
                <%= render "shared/arrows" %>
              <% end %>
            </div>
          <% end %>
          <% if @current_round.revealed? %>
            <div class="rounded-xl bg-slate-100 p-4">
              <div class="flex items-center justify-center gap-3">
                <h2 class="mb-3 text-lg font-semibold text-slate-800">Result:</h2>
                <% if @current_round.successful? %>
                  <p class="mb-4 rounded-xl bg-green-100 px-4 py-3 font-semibold text-green-800">
                    Success! The order was correct.
                  </p>
                <% else %>
                  <p class="mb-4 rounded-xl bg-red-100 px-4 py-3 font-semibold text-red-800">
                    Failure! The order was not correct.
                  </p>
                <% end %>
              </div>
              <div class="flex flex-wrap gap-4">
                <% @current_round.round_assignments.order(:display_order).each do |assignment| %>
                  <div class="w-36 h-48 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                    <div class="flex h-full flex-col">
                      <!-- Header -->
                      <div class="flex items-center gap-2">
                        <%= render "shared/diamond", assignment: assignment %>
                        <span class="truncate text-sm font-semibold text-slate-700">
                          <%= assignment.player.nickname %>
                        </span>
                      </div>
                      <!-- Clue -->
                      <div class="flex flex-1 items-center justify-center px-1">
                        <p class="text-center text-lg font-semibold leading-tight text-slate-900 wrap-break-word">
                          <%= assignment.clue_text %>
                        </p>
                      </div>
                      <!-- Footer (empty for now) -->
                      <div class="h-6">
                        <!-- Future: revealed number, badges, etc. -->
                        <div class="mt-auto pt-2 text-end">
                          <span class="text-xl font-bold text-slate-900">
                            <%= assignment.secret_number %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              <!-- 1 to 100 and the Arrow -->
              <%= render "shared/arrows" %>
            </div>
          <% end %>
          <% current_assignment = @current_round.current_assignment %>
          <% if current_assignment && @current_round.turn? %>
            <div class="rounded-xl bg-slate-100 p-4">
              <h2 class="mb-2 text-lg font-semibold text-slate-800">Current Turn</h2>
              <p class="text-slate-700">
                <strong>Player:</strong> <%= current_assignment.player.nickname %>
              </p>
              <% if @current_round.turn? %>
                <% if current_player&.id == current_assignment.player_id %>
                  <p class="mt-3 text-slate-700">
                    Your secret number for this card:
                    <span class="font-bold text-slate-900"><%= current_assignment.secret_number %></span>
                  </p>
                  <div class="mt-4">
                    <%= form_with url: submit_clue_round_path(@current_round), method: :post, local: true, class: "space-y-3" do |form| %>
                      <div>
                        <%= form.label :clue_text, "Your clue", class: "mb-1 block text-sm font-medium text-slate-700" %>
                        <%= form.text_field :clue_text, required: true, class: "w-full rounded-xl border border-slate-300 px-4 py-2 focus:border-slate-500 focus:outline-none" %>
                      </div>
                      <div class="flex gap-3">
                        <%= form.submit "Submit Clue", class: "rounded-xl bg-slate-800 px-4 py-2 font-semibold text-white hover:bg-slate-700" %>
                      <% end %>
                      <%= button_to "Go Later",
                  go_later_round_path(@current_round),
                  method: :post,
                  class: "rounded-xl bg-slate-200 px-4 py-2 font-semibold text-slate-800 hover:bg-slate-300" %>
                    </div>
                  </div>
                <% else %>
                  <p class="mt-3 text-slate-600">Waiting for the current player to submit a clue...</p>
                <% end %>
              <% elsif @current_round.arranging? %>
                <p class="mt-3 text-slate-600">Waiting for the host to arrange the cards...</p>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
<%# </div> %>
